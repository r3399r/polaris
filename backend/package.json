{
  "name": "polaris",
  "version": "1.1.5",
  "author": "Yue Chang",
  "scripts": {
    "lint:es": "eslint src regression tools",
    "fix:es": "npm run lint:es -- --fix",
    "lint:format": "prettier --config ./prettierrc.json --list-different \"./**/*.ts\" --ignore-path .gitignore",
    "fix:format": "npm run lint:format -- --write",
    "lint": "run-p lint:*",
    "fix": "run-s fix:*",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "clean": "del-cli dist lib -f",
    "db:up": "docker compose up -d --wait mysql cockroach && docker compose run --rm cockroach-init",
    "db:down": "docker compose down",
    "test:unit": "vitest run --dir src",
    "test:regression": "vitest run --dir regression",
    "test": "run-s test:unit test:regression",
    "test:coverage": "vitest run --dir src --coverage",
    "openapi": "tsx tools/openapi.ts",
    "build:layer": "npm install --production && mkdir -p dist/nodejs && cp -R node_modules dist/nodejs",
    "build:lambda": "npm install && tspc",
    "pre:commit": "run-s lint test:coverage build",
    "pre:dev": "run-s fix test:coverage",
    "pre:deploy": "run-s clean build:*"
  },
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-rds": "^3.1169.0",
    "axios": "^1.11.0",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^9.14.1",
    "google-spreadsheet": "^4.1.4",
    "hono": "^4.13.19",
    "hono-openapi": "^1.6.0",
    "mysql2": "^3.14.1",
    "pg": "^8.16.2",
    "tslib": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@types/pg": "^8.15.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitest/coverage-v8": "^5.1.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.29.0",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.32.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.0",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-transform-paths": "^3.5.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  }
}
